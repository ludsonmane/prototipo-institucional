# Site
NEXT_PUBLIC_SITE_URL=https://mane.com.vc

# API de Reservas (mane-reservas-api)
# - MANE_API_BASE  → usado em código server-side (route handlers, RSC)
# - NEXT_PUBLIC_RESERVAS_API → usado se precisar acessar do browser
MANE_API_BASE=https://api.mane.com.vc
NEXT_PUBLIC_RESERVAS_API=https://api.mane.com.vc

# Banco MySQL de Reservas (Railway) — SERVER-SIDE only
# Pegue em Railway > mane-reservas (mysql) > Variables > MYSQL_PUBLIC_URL
RESERVAS_DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DBNAME
